programa {
    funcao inicio() {
        caractere nome
        inteiro idade
        real altura
        escreva("Nome: ")
        leia(nome)
        escreva("Idade: ")
        leia(idade)
        escreva("Altura: ")
        leia(altura)
        escreval("Nome: ", nome, " | Idade: ", idade, " | Altura: ", altura)
    }
}
